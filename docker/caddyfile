{$SITE_ADDRESS} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
    header /assets/* Cache-Control "public, max-age=31536000, immutable"

    handle /static/* {
        root * /srv
        file_server
    }

    @backend path /admin/* /accounts/* /me/* /leaderboard/* /games/* /sessions/* /minesweeper/* /pacman/* /snake/* /tetris/* /wordle/*
    handle @backend {
        reverse_proxy web:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
